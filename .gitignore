# ==========================================
# 1. Kathara & Networking Artifacts
# ==========================================
# Packet captures generated by Wireshark/tcpdump
*.pcap
*.pcapng

# Log files generated by Kathara nodes, Ryu, or OVS
*.log

# ==========================================
# 2. Python Artifacts
# ==========================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments (created by uv or standard venv)
.venv/
venv/
env/

# Python packaging/distribution
*.egg-info/
.eggs/
dist/
build/

# ==========================================
# 3. Environment Variables & Secrets
# ==========================================
# Never commit your environment variables or secrets
.env
.env.*
!.env.example

# ==========================================
# 4. IDEs and Editors
# ==========================================
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains (PyCharm, WebStorm, etc.)
.idea/

# Helix / Vim / Emacs (if applicable)
*.swp
*.swo
*~

# ==========================================
# 5. OS Specific
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
